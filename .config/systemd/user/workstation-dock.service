[Unit]
Description=Minimal monochrome launcher dock alongside Caelestia
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Environment=QS_NO_RELOAD_POPUP=1
ExecStart=/usr/bin/qs -c workstation-dock -n
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
