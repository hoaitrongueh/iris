#!/bin/sh
# Use the packaged application and existing profile. Explicit backend arguments win.
# X11-only sessions retain the vendor launch behavior.
for arg do
    case "$arg" in
        --ozone-platform|--ozone-platform=*) exec /usr/bin/chatgpt "$@" ;;
    esac
done
if [ -n "${WAYLAND_DISPLAY:-}" ] && [ "${XDG_SESSION_TYPE:-}" = wayland ]; then
    exec /usr/bin/chatgpt --ozone-platform=wayland "$@"
fi
exec /usr/bin/chatgpt "$@"
