#!/usr/bin/env python3
"""Cycle visible windows in stable address order, independent of focus/stack order."""
import json
import re
import subprocess
import sys

def target(clients, active, workspace, monitor, backwards=False):
    windows = sorted(c['address'] for c in clients
                     if c.get('mapped', True) and not c.get('hidden', False)
                     and re.fullmatch(r'0x[0-9a-fA-F]+', c.get('address', ''))
                     and (c.get('workspace', {}).get('id') == workspace
                          or (c.get('pinned') and c.get('monitor') == monitor)))
    if not windows:
        return None
    if active not in windows:
        return windows[-1 if backwards else 0]
    return windows[(windows.index(active) + (-1 if backwards else 1)) % len(windows)]

def main():
    def query(name):
        return json.loads(subprocess.check_output(['hyprctl', '-j', name], timeout=3))
    active = query('activewindow')
    monitors = query('monitors')
    monitor = next((m for m in monitors if m.get('focused')), None)
    if monitor is None:
        return
    special = monitor.get('specialWorkspace', {}).get('id', 0)
    workspace = special or monitor['activeWorkspace']['id']
    address = target(query('clients'), active.get('address'), workspace, monitor['id'], '--reverse' in sys.argv)
    if address and address != active.get('address'):
        result = subprocess.run(['hyprctl', 'dispatch', 'hl.dsp.focus({window=' + json.dumps('address:' + address) + '})'], capture_output=True, text=True, check=True, timeout=3)
        if result.stdout.strip() != 'ok':
            raise ValueError(result.stdout.strip() or result.stderr.strip() or 'Focus dispatch failed')

if __name__ == '__main__':
    try:
        main()
    except (subprocess.SubprocessError, OSError, ValueError, KeyError) as exc:
        print('Window cycle unavailable: ' + str(exc), file=sys.stderr)
        sys.exit(1)
