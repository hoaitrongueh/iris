#!/usr/bin/env python3
"""Toggle only the active window between tiling and centered 65% glass composition."""
import json
import subprocess
import sys

def query(name):
    r = subprocess.run(['hyprctl', '-j', name], capture_output=True, text=True, timeout=5)
    if r.returncode:
        raise RuntimeError(r.stderr.strip() or r.stdout.strip() or 'Hyprland IPC unavailable')
    return json.loads(r.stdout)

def main():
    w = query('activewindow')
    if not w.get('address'):
        return
    if w.get('fullscreen', 0):
        raise RuntimeError('Leave fullscreen before toggling presentation layout.')
    m = next(m for m in query('monitors') if m['id'] == w['monitor'])
    width, height = m['width'], m['height']
    if m.get('transform', 0) % 2:
        width, height = height, width
    width, height = round(width / m['scale'] * .65), round(height / m['scale'] * .65)

    code = ('local w=hl.get_active_window(); if w and w.address==' + json.dumps(w['address'])
            + ' then hl.dispatch(hl.dsp.window.float({action="toggle"})); ')
    if not w['floating']:
        code += (f'hl.dispatch(hl.dsp.window.resize({{x={width},y={height},relative=false}})); '
                 'hl.dispatch(hl.dsp.window.center()); ')
    code += 'end'
    r = subprocess.run(['hyprctl', 'eval', code], capture_output=True, text=True, timeout=5)
    if r.returncode or (r.stdout.strip() and r.stdout.strip() != 'ok'):
        raise RuntimeError(r.stderr.strip() or r.stdout.strip())

if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, ValueError, KeyError, StopIteration, subprocess.TimeoutExpired) as e:
        print(f'Presentation toggle: {e}', file=sys.stderr)
        sys.exit(1)
