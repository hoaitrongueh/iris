#!/usr/bin/env python3
"""Snapshot panels block on terminal input; clock wakes once per minute."""
import datetime, os, select, subprocess, sys
mode=sys.argv[1] if len(sys.argv)>1 else 'system'
print('\033[?25l',end='',flush=True)
try:
    if mode=='system':
        print('  I R I S   //   QUIET ENGINEERING\n',flush=True)
        subprocess.run(['fastfetch','--config',os.path.expanduser('~/.config/iris/fastfetch.json')],check=True)
        print('\n  RELIC / robotics    PRISM / inference\n  HAND  / biomimetics\n\n  snapshot at '+datetime.datetime.now().strftime('%H:%M')+'   ·   Super+G to hide',flush=True)
        sys.stdin.read()
    elif mode=='identity':
        print('  I R I S\n  ────────────────────────\n  ARCH / HYPRLAND\n\n  RELIC   // robotics\n  PRISM   // inference\n  HAND    // biomimetics',flush=True)
        sys.stdin.read()
    elif mode=='clock':
        while True:
            now=datetime.datetime.now()
            print('\033[H\033[2J\n  '+now.strftime('%H : %M')+'\n\n  '+now.strftime('%A / %d %B').upper(),flush=True)
            if select.select([sys.stdin],[],[],60-now.second)[0]:
                if not sys.stdin.read(1): break
    else: raise SystemExit('Use system|identity|clock')
finally:
    print('\033[?25h',end='',flush=True)
