#!/usr/bin/env python3
"""Restore the complete grayscale palette through Caelestia's user state.

The upstream CLI 1.1.3 theme postHook calls this after any theme update.
No installed QML/Python is patched, and this does not invoke the CLI recursively.
"""
import json
import os
from pathlib import Path
import tempfile

home = Path.home()
source = home / '.config/caelestia/iris-monochrome.json'
target = Path(os.getenv('XDG_STATE_HOME', home / '.local/state')) / 'caelestia/scheme.json'
data = source.read_bytes()
scheme = json.loads(data)
assert scheme['mode'] == 'dark'
assert all(len(c) == 6 and c[:2] == c[2:4] == c[4:] for c in scheme['colours'].values())
target.parent.mkdir(parents=True, exist_ok=True)
if not target.exists() or target.read_bytes() != data:
    with tempfile.NamedTemporaryFile(dir=target.parent, delete=False) as f:
        f.write(data)
        f.flush()
        os.fsync(f.fileno())
        temporary = f.name
    os.replace(temporary, target)
